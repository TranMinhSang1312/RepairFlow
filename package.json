{
  "name": "repairflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "predev": "pnpm build:packages && pnpm dev:infra",
    "dev": "pnpm dev:apps",
    "dev:apps": "pnpm --parallel --stream --filter @repairflow/web --filter @repairflow/api --filter @repairflow/worker dev",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "build:packages": "pnpm --filter @repairflow/contracts --filter @repairflow/config --filter @repairflow/security build",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint prisma/seed.ts prisma.config.ts && pnpm -r --if-present lint",
    "typecheck": "pnpm build:packages && pnpm typecheck:tools && pnpm -r --if-present typecheck",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "test": "pnpm -r --if-present test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.1",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
