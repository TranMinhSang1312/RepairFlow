DATABASE_URL="postgresql://repairflow:repairflow@localhost:5432/repairflow?schema=public"
NODE_ENV="development"
LOG_LEVEL="info"
API_HOST="0.0.0.0"
API_PORT="3001"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
WORKER_POLL_INTERVAL_MS="5000"
WORKER_BATCH_SIZE="10"
WORKER_LEASE_MS="30000"
WORKER_MAX_ATTEMPTS="5"
WORKER_RETRY_BASE_MS="1000"
WORKER_RETRY_MAX_MS="60000"
WORKER_HEALTH_HOST="0.0.0.0"
WORKER_HEALTH_PORT="3002"
WORKER_READINESS_STALE_MS="30000"
WORKER_ALERT_FAILURE_THRESHOLD="3"
WORKER_ALERT_DEAD_LETTER_THRESHOLD="1"
WORKER_NOTIFICATION_PROVIDER="fake"
# Set the following values and switch the provider to "email" to deliver through Resend.
# RESEND_API_KEY="re_replace-with-resend-api-key"
# RESEND_FROM_EMAIL="RepairFlow <notify@example.com>"
# RESEND_REPLY_TO_EMAIL="support@example.com"
RESEND_API_URL="https://api.resend.com/emails"
RESEND_TIMEOUT_MS="10000"
ACCESS_TOKEN_SECRET="replace-with-at-least-32-random-bytes"
PUBLIC_TOKEN_SECRET="replace-with-a-different-32-byte-random-secret"
PUBLIC_WEB_URL="http://localhost:3000"
REFRESH_COOKIE_NAME="repairflow_refresh"
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_BUCKET="repairflow-private"
OBJECT_STORAGE_ACCESS_KEY="repairflow"
OBJECT_STORAGE_SECRET_KEY="local-development-only"
AI_MAX_IMAGE_BYTES="10000000"
AI_ENABLED="false"
AI_PROVIDER="fake"
AI_TIMEOUT_MS="15000"
AI_MAX_OUTPUT_BYTES="65536"
AI_CIRCUIT_BREAKER_THRESHOLD="5"
AI_CIRCUIT_BREAKER_COOLDOWN_MS="30000"
AI_WORKER_BATCH_SIZE="2"
AI_WORKER_LEASE_MS="120000"
AI_WORKER_MAX_ATTEMPTS="2"
AI_PRICE_TABLE_VERSION="unpriced-local"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"
# Required with positive prices when AI_ENABLED=true and AI_PROVIDER=deepseek.
# DEEPSEEK_API_KEY="replace-with-deepseek-api-key"
DEEPSEEK_INPUT_PRICE_MICROUSD_PER_MILLION_TOKENS="0"
DEEPSEEK_OUTPUT_PRICE_MICROUSD_PER_MILLION_TOKENS="0"
