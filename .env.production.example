NODE_ENV=production
RELEASE_VERSION=2026.09.30
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/repairflow?sslmode=require
API_HOST=0.0.0.0
API_PORT=3001
API_TRUST_PROXY_HOPS=2
RATE_LIMIT_NAMESPACE=production
ACCESS_TOKEN_SECRET=generate-a-unique-64-byte-secret
PUBLIC_TOKEN_SECRET=generate-a-different-64-byte-secret
REFRESH_COOKIE_NAME=repairflow_refresh
PUBLIC_WEB_URL=https://repair.example.com
NEXT_PUBLIC_API_URL=http://api:3001/api/v1
NEXT_PUBLIC_OBJECT_STORAGE_ORIGIN=https://s3.example.com
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_REGION=ap-southeast-1
OBJECT_STORAGE_BUCKET=repairflow-private
OBJECT_STORAGE_ACCESS_KEY=least-privilege-access-key
OBJECT_STORAGE_SECRET_KEY=least-privilege-secret
WORKER_NOTIFICATION_PROVIDER=email
RESEND_API_KEY=configure-in-secret-manager
RESEND_FROM_EMAIL=RepairFlow <notify@example.com>
RESEND_REPLY_TO_EMAIL=support@example.com
AI_ENABLED=false
AI_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=configure-in-secret-manager
DEEPSEEK_INPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=1
DEEPSEEK_OUTPUT_PRICE_MICROUSD_PER_MILLION_TOKENS=1
